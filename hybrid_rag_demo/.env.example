# ============================================
# 阿里云百炼平台配置
# Alibaba Bailian Configuration
# ============================================

# API Key - 从阿里云百炼平台获取
API_KEY=sk-abe3417c96f6441b83efed38708bcfb6

# API Base URL - 兼容OpenAI格式
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM模型
# 可选: qwen-turbo, qwen-plus, qwen-max
MODEL_ID=qwen-plus

# 嵌入模型
# 可选: text-embedding-v1, text-embedding-v2
EMBEDDING_MODEL=text-embedding-v1

# ============================================
# 系统配置
# ============================================

# 日志级别
LOG_LEVEL=INFO

# ============================================
# 获取API Key方法
# ============================================

# 1. 访问: https://bailian.console.aliyun.com/
# 2. 进入"API-KEY管理"页面
# 3. 创建新的API Key
# 4. 复制到上面的API_KEY字段

# ============================================
# 使用说明
# ============================================

# 1. 复制此文件为 .env:
#    cp .env.example .env

# 2. 编辑 .env 文件，填入你的API Key

# 3. 运行程序:
#    python hybrid_rag.py
