# ==================== LLM 提供商配置 ====================
# 可选值: "ollama" (本地模型) 或 "online" (在线 API)
LLM_PROVIDER=ollama

# ==================== Ollama 配置 (本地模型) ====================
# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ==================== 在线 API 配置 (阿里云百炼) ====================
# 阿里云百炼 API Key
ONLINE_API_KEY=sk-abe3417c96f6441b83efed38708bcfb6

# 阿里云百炼 API 地址
ONLINE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== 天气 API 配置 ====================
# 高德地图 API Key (可选，用于天气查询功能)
WEATHER_API_KEY=你的高德地图API密钥

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==================== 使用说明 ====================
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 根据需要选择 LLM 提供商:
#
#    【使用本地 Ollama】
#    LLM_PROVIDER=ollama
#    - 需要先安装 Ollama: https://ollama.ai/
#    - 下载模型: ollama pull qwen:7b
#    - 启动服务: ollama serve
#
#    【使用在线 API (阿里云百炼)】
#    LLM_PROVIDER=online
#    - 将 ONLINE_API_KEY 替换为您的实际 API Key
#    - 默认配置已包含测试 API Key
#
# 3. (可选) 配置天气查询功能
#    - 访问 https://lbs.amap.com/ 申请 API Key
#    - 将 WEATHER_API_KEY 替换为您的 API Key
#
# 4. 启动应用
#    streamlit run app.py
