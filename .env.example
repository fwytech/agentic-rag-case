# ============================================
# 阿里云百炼平台配置 (Alibaba Bailian/DashScope)
# ============================================

# API Key - 从阿里云百炼平台获取
API_KEY=sk-abe3417c96f6441b83efed38708bcfb6

# API Base URL - 阿里云百炼兼容OpenAI格式的端点
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM模型ID - 大语言模型
# 可选值: qwen-turbo, qwen-plus, qwen-max, qwen-max-longcontext
MODEL_ID=qwen-plus

# 嵌入模型 - 用于生成向量
# 可选值: text-embedding-v1, text-embedding-v2
EMBEDDING_MODEL=text-embedding-v1

# ============================================
# ChromaDB配置 (本地向量数据库)
# ============================================

# ChromaDB数据存储路径 (相对路径或绝对路径)
# 传统RAG: ./chroma_db
# Agentic RAG: ./chroma_db_agentic
CHROMA_DB_PATH=./chroma_db

# 集合名称
TRADITIONAL_RAG_COLLECTION=traditional_rag_collection
AGENTIC_RAG_COLLECTION=agentic_rag_collection

# ============================================
# 应用配置
# ============================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Agentic RAG最大迭代次数
MAX_AGENT_ITERATIONS=5

# 向量搜索返回文档数量
TOP_K=3

# Web搜索最大结果数
WEB_SEARCH_MAX_RESULTS=3

# ============================================
# 高级配置 (可选)
# ============================================

# LLM温度参数 (0.0-1.0)
# 较低值(0.3)用于决策/评估,较高值(0.7)用于生成
TEMPERATURE_REASONING=0.3
TEMPERATURE_GENERATION=0.7

# 最大Token数
MAX_TOKENS_REASONING=500
MAX_TOKENS_GENERATION=1000
MAX_TOKENS_EVALUATION=300

# 请求超时时间(秒)
REQUEST_TIMEOUT=30

# ============================================
# 阿里云百炼平台说明
# ============================================

# 1. 获取API Key:
#    访问: https://bailian.console.aliyun.com/
#    进入"API-KEY管理"页面创建API Key

# 2. 模型说明:
#    - qwen-turbo: 快速响应,成本最低
#    - qwen-plus: 平衡性能和成本 (推荐)
#    - qwen-max: 最强性能
#    - qwen-max-longcontext: 支持超长上下文

# 3. 兼容性:
#    阿里云百炼平台提供OpenAI兼容接口
#    可以使用openai Python包直接调用

# 4. 计费方式:
#    按Token计费,详见官方文档

# ============================================
# ChromaDB说明
# ============================================

# 1. 本地存储:
#    ChromaDB将数据存储在本地文件系统
#    无需额外的数据库服务器

# 2. 持久化:
#    使用PersistentClient自动持久化数据
#    重启程序后数据不会丢失

# 3. 优势:
#    - 零配置,开箱即用
#    - 轻量级,适合开发和小规模应用
#    - 支持向量相似度搜索
#    - 免费开源

# 4. 限制:
#    - 不适合大规模生产环境
#    - 并发性能有限
#    - 建议文档数 < 100万

# ============================================
# 使用示例
# ============================================

# 复制此文件为 .env
# cp .env.example .env

# 编辑 .env 文件,填入你的API Key
# nano .env

# 运行示例代码
# python traditional_rag.py
# python agentic_rag.py

# ============================================
# 安全提示
# ============================================

# 1. .env 文件已在 .gitignore 中,不会被提交到git
# 2. 请妥善保管你的API Key,不要泄露给他人
# 3. 生产环境建议使用密钥管理服务
# 4. 定期轮换API Key以提高安全性
