# ============================================
# Elasticsearch Configuration
# ============================================

# Elasticsearch用户名
ES_USER=elastic

# Elasticsearch密码
ES_PASSWORD=your_elasticsearch_password

# Elasticsearch端点 (不包含协议和端口)
ES_ENDPOINT=localhost

# ============================================
# Azure OpenAI Configuration - Embeddings
# ============================================

# 嵌入模型名称
MODEL_NAME=text-embedding-ada-002

# Azure OpenAI嵌入服务端点
AZURE_EMBEDDING_ENDPOINT=https://your-resource-name.openai.azure.com/

# Azure OpenAI嵌入服务API密钥
AZURE_EMBEDDING_API_KEY=your_embedding_api_key_here

# Azure OpenAI API版本
AZURE_EMBEDDING_API_VERSION=2023-05-15

# ============================================
# Azure OpenAI Configuration - Chat/Completion
# ============================================

# Azure OpenAI聊天完成服务API密钥
AZURE_API_KEY=your_completion_api_key_here

# Azure OpenAI聊天完成服务端点
AZURE_ENDPOINT=https://your-resource-name.openai.azure.com/

# Azure OpenAI API版本
AZURE_API_VERSION=2023-05-15

# Azure OpenAI部署ID/模型名称
AZURE_DEPLOYMENT_ID=gpt-4

# ============================================
# Alternative: OpenAI Configuration (Optional)
# ============================================

# 如果使用OpenAI官方API而非Azure,使用以下配置
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_ORG_ID=your_organization_id  # 可选

# ============================================
# Alternative: DeepSeek Configuration (Optional)
# ============================================

# 如果使用DeepSeek API
# OPENAI_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_URL=https://api.deepseek.com/v1

# ============================================
# Web Search Configuration (Optional)
# ============================================

# DuckDuckGo搜索不需要API密钥,但可以配置其他搜索引擎

# Brave Search API (如果使用)
# BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Serper API (如果使用)
# SERPER_API_KEY=your_serper_api_key_here

# ============================================
# Application Configuration
# ============================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 最大重试次数
MAX_RETRIES=3

# 请求超时时间(秒)
REQUEST_TIMEOUT=30

# Agentic RAG最大迭代次数
MAX_AGENT_ITERATIONS=5

# ============================================
# Cache Configuration (Optional)
# ============================================

# Redis配置 (如果使用缓存)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# 缓存TTL(秒)
# CACHE_TTL=3600

# ============================================
# Performance Optimization
# ============================================

# 批处理大小
BATCH_SIZE=10

# 并发请求数
CONCURRENT_REQUESTS=5

# 向量搜索返回文档数量
TOP_K=3

# 相似度阈值
SIMILARITY_THRESHOLD=0.7

# ============================================
# Monitoring and Analytics (Optional)
# ============================================

# LangSmith追踪 (如果使用)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=your_project_name

# ============================================
# Security Settings
# ============================================

# 是否启用API密钥验证
# ENABLE_AUTH=true
# API_KEY=your_application_api_key

# 允许的CORS来源
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# Notes
# ============================================

# 1. 复制此文件为 .env 并填入实际值
# 2. .env 文件已在 .gitignore 中,不会被提交到git
# 3. 所有密钥和敏感信息请妥善保管
# 4. 生产环境建议使用密钥管理服务 (如Azure Key Vault)
